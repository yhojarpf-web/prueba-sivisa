epidemiologia/data/unidades/*.geojson

# Excepción: los Excel mensuales de calidad del agua (datos agregados por sistema, sin datos personales) sí se suben
!salud-ambiental/datos/agua/*.xlsx
!salud-ambiental/datos/agua/*/*.xlsx
!salud-ambiental/datos/vectores/*/*.xlsx
!salud-ambiental/datos/vectores/*/*/*.xlsx
